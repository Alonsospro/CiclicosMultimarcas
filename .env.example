# NIBOL Inventarios - Environment Variables
PORT=3000
NODE_ENV=development
JWT_SECRET=
ADMIN_DELETE_KEY=

# Cuota diaria de Firestore para el indicador de consumo (avisos al 70% y al 90%). No detiene nada.
# Vacío usa la cuota gratuita: 50000 lecturas y 20000 escrituras.
FIRESTORE_DAILY_READ_QUOTA=
FIRESTORE_DAILY_WRITE_QUOTA=

# Conteos hacia Google Sheets: vacío los envía en lotes; "inmediato" espera a Sheets en cada conteo.
COUNT_SHEET_SYNC=

# Google Apps Script Webhooks
CICLICOS_URL=
BARRIDO_URL=
MENSUALES_URL=
SEMANALES_URL=

# Reference photos & Drive IDs
REFERENCE_PHOTOS_DIR=
DRIVE_MAIN_FOLDER_URL=
DRIVE_MAIN_FOLDER_ID=
DRIVE_LOGO_FOLDER_URL=
DRIVE_LOGO_FOLDER_ID=
DRIVE_SNAPSHOTS_FOLDER_URL=
DRIVE_SNAPSHOTS_FOLDER_ID=
DRIVE_BASE_FILES_FOLDER_URL=
DRIVE_BASE_FILES_FOLDER_ID=
DRIVE_DAMAGED_FOLDER_URL=
DRIVE_DAMAGED_FOLDER_ID=
DRIVE_JUSTIF_FOLDER_URL=
DRIVE_JUSTIF_FOLDER_ID=
DRIVE_REFERENCE_FOLDER_URL=
DRIVE_REFERENCE_FOLDER_ID=
SNAPSHOT_FOLDER_PATH=

# Cada token debe coincidir con APPS_SCRIPT_TOKEN en el proyecto Apps Script
# correspondiente. Si no se define un token por tipo, se usa el token compartido.
CICLICOS_APPS_SCRIPT_TOKEN=
BARRIDO_APPS_SCRIPT_TOKEN=
MENSUALES_APPS_SCRIPT_TOKEN=
SEMANALES_APPS_SCRIPT_TOKEN=
# Respaldo temporal/compatibilidad para un único token compartido.
APPS_SCRIPT_TOKEN=
