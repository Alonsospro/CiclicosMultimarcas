rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_files/{fileId} {
      allow read: if resource != null && resource.data.secret == 'NIBOL_BACKEND_SECRET_987654321';
      allow write: if request.resource != null && request.resource.data.secret == 'NIBOL_BACKEND_SECRET_987654321';
      allow delete: if resource == null || resource.data.secret == 'NIBOL_BACKEND_SECRET_987654321';
    }
  }
}
